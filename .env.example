# Copy this file to .env and fill in real values. Never commit .env.
# This file documents variable NAMES and PURPOSE only — no real secrets. See docs/security.md §9.

# --- General ---
NODE_ENV=development

# --- Database (Docker Compose Postgres service) ---
POSTGRES_USER=ats_dev
POSTGRES_PASSWORD=ats_dev_password
POSTGRES_DB=ats_dev
POSTGRES_PORT=5432

# Used when running the backend OUTSIDE docker compose (e.g. `npm run
# start:dev` from backend/), connecting to Postgres via its port published
# to the host. Inside docker compose, the backend container is given an
# equivalent URL pointing at the `postgres` service name instead — see
# docker-compose.yml.
DATABASE_URL=postgresql://ats_dev:ats_dev_password@localhost:5432/ats_dev?schema=public

# --- Backend ---
BACKEND_PORT=3001

# --- Auth (see docs/authentication.md) ---
# Signs/verifies access tokens (JWT). Refresh tokens are opaque random
# strings stored hashed in the DB, not JWTs -- no separate secret needed.
# Generate a real value with e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# bcryptjs salt rounds -- higher is slower/more resistant to brute force.
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# REQ-AUTH-008: staff invitation tokens expire after 7 days.
INVITATION_TTL_DAYS=7
# Set to false to disable rate limiting entirely (e.g. load testing). The
# e2e test suite sets this itself (test/jest-e2e.setup.ts) -- leave it
# true/unset everywhere else.
THROTTLE_ENABLED=true
# Bootstraps the first Super Admin account when the seed script runs (see
# docs/open-questions.md Q13) -- there is no other way to create one.
# Leave unset in an environment where you don't want this account seeded.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-real-password

# --- Frontend ---
FRONTEND_PORT=3000
# Consumed by the browser, so it must be a host-reachable URL, not a
# docker-compose service name, even when the frontend runs in a container.
NEXT_PUBLIC_API_URL=http://localhost:3001
